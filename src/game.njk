---
layout: base.njk
pagination:
  data: games
  size: 1
  alias: g
permalink: "/{{ g.slug }}/"
eleventyComputed:
  title: "{{ g.title }}"
  description: "{{ g.tagline }} — {{ g.desc }}"
---
{% from "partials/icons.njk" import storeButtons %}

<article class="gamepage">
  <div class="wrap">
    <p class="legal-back gamepage-back"><a href="/">← 모든 게임</a></p>

    <div class="gamepage-art media" data-label="{{ g.title }}">
      <img src="{{ g.art }}" alt="{{ g.title }}" width="1024" height="500">
    </div>

    <div class="gamepage-body">
      <h1>{{ g.title }}</h1>
      <p class="gamepage-en">{{ g.titleEn }}</p>
      <p class="gamepage-tagline">{{ g.tagline }}</p>
      <p class="gamepage-desc">{{ g.desc }}</p>
      {{ storeButtons(g.stores) }}
    </div>
  </div>
</article>
